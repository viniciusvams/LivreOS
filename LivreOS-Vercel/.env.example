APP_NAME="LivreOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=true
APP_URL=http://www.livreos.com.br
# Logo do sistema (caminho em relação a public/). Ex.: logo/logo-Livre-OS .jpg
# APP_LOGO=logo/logo-Livre-OS .jpg
# APP_TAGLINE=ERP Open Source Livre
# Para acessar pelo IP da máquina (ex.: http://192.168.x.x), mantenha SESSION_DOMAIN=null

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# SQLite: menos "database is locked" (ms de espera; WAL = leituras em paralelo à escrita)
SQLITE_BUSY_TIMEOUT_MS=10000
SQLITE_WAL=true
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=livreos
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Fila: use "sync" em hospedagem compartilhada sem acesso a comandos/cron — os jobs (ex.: e-mails) rodam na mesma requisição.
# Use "database" se tiver worker (queue:work) ou se chamar /run-tarefas via cron por URL (a URL também processa a fila).
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Token para executar tarefas agendadas via URL (hospedagem sem cron).
# Use em: GET /run-tarefas?token=SEU_TOKEN
# Gere um valor aleatório seguro (ex.: php -r "echo bin2hex(random_bytes(24));")
CRON_SECRET_TOKEN=

# Opcional: token só para scripts de patch na raiz (ex.: aplicar-sumup-instalacao.php). Se vazio, o patch aceita CRON_SECRET_TOKEN.
# APPLY_PATCH_TOKEN=

# Página pública do equipamento (/e/{token}). false = só token opaco no QR (recomendado).
# true = permite /e/123 com ID da OS (retrocompatível, porém permite enumeração).
# EQUIPAMENTO_PUBLICO_PERMITIR_ID_NA_URL=false

# Em ambiente local, se a API do BCB (índices IPCA/INPC/IGP-M) falhar por SSL, use:
# BCB_VERIFY_SSL=false

# Distância/tempo entre endereços na Rota do dia (plugin Atendimento). Ative "Distance Matrix API" no Google Cloud.
# GOOGLE_MAPS_API_KEY=

# Importação M-OS / sistema externo (ZIP grande): limite de memória só durante o fluxo do plugin (-1 = sem limite no PHP)
# MOS_IMPORT_MEMORY_LIMIT=2048M
